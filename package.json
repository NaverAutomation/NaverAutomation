{
  "name": "naver-auto",
  "version": "0.3.349",
  "description": "Naver Blog Automation with AI",
  "type": "module",
  "main": "src/main.js",
  "author": "Naver Auto Dev Team",
  "homepage": "./",
  "bin": {
    "naver-auto": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "playwright:install": "playwright install chromium",
    "postinstall": "npm run playwright:install",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && npm run playwright:install && electron-builder build --win --publish never"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.15",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
